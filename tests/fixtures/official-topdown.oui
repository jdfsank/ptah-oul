root = GameProject("coin_lane", {profile: "game2d/1.0", entry_scene: "main", viewport: [480, 270], fixed_hz: 60, input_map: {move_right: ["KeyD"]}}, [main])
$score = 0
main = Scene2D("main", {gravity: [0, 0]}, [background, lane, stripe, player, coin, goal, hud, flow])
background = Polygon2D("background", {polygon: [[0, 0], [480, 0], [480, 270], [0, 270]], color: "#14251F"}, [])
lane = Polygon2D("lane", {polygon: [[28, 180], [55, 142], [425, 142], [452, 180], [425, 218], [55, 218]], color: "#29463B"}, [])
stripe = Polygon2D("stripe", {polygon: [[60, 178], [420, 178], [420, 182], [60, 182]], color: "#477464"}, [])
player = CharacterBody2D("player", {position: [60, 180], collision_layer: 1, collision_mask: 0}, [player_shape, player_visual, move])
player_shape = CollisionShape2D("player_shape", {shape: {type: "RectangleShape2D", size: [24, 24]}}, [])
player_visual = Polygon2D("player_visual", {polygon: [[-12, -12], [2, -12], [14, 0], [2, 12], [-12, 12], [-6, 0]], color: "#7DD3FC"}, [])
move = TopDownController("move", {right_action: "move_right", speed: 140}, [])
coin = Area2D("coin", {position: [200, 180], collision_layer: 0, collision_mask: 1, monitoring: true}, [coin_shape, coin_visual, pickup])
coin_shape = CollisionShape2D("coin_shape", {shape: {type: "CircleShape2D", radius: 12}}, [])
coin_visual = Polygon2D("coin_visual", {polygon: [[-5, -11], [5, -11], [11, -5], [11, 5], [5, 11], [-5, 11], [-11, 5], [-11, -5]], color: "#FBBF24"}, [])
pickup = SignalRule("pickup", {signal: "body_entered", once: true, action: Action([@Set($score, $score + 1), @DestroyNode("coin")])}, [])
goal = Area2D("goal", {position: [405, 180], collision_layer: 0, collision_mask: 1, monitoring: true}, [goal_shape, goal_visual, goal_inset, win_trigger])
goal_shape = CollisionShape2D("goal_shape", {shape: {type: "RectangleShape2D", size: [36, 48]}}, [])
goal_visual = Polygon2D("goal_visual", {polygon: [[-18, 24], [-18, -12], [-8, -24], [8, -24], [18, -12], [18, 24]], color: "#4ADE80"}, [])
goal_inset = Polygon2D("goal_inset", {polygon: [[-10, 24], [-10, -9], [-4, -16], [4, -16], [10, -9], [10, 24]], color: "#166534"}, [])
win_trigger = SignalRule("win_trigger", {signal: "body_entered", once: true, action: @EmitGameEvent("goal_reached")}, [])
hud = CanvasLayer("hud", {layer: 10}, [help_label, score_label, win_label, restart])
help_label = Label("help_label", {position: [24, 18], text: "按 D 向右，拾取金币后进入绿色出口"}, [])
score_label = Label("score_label", {position: [24, 48], text: "金币：" + $score}, [])
win_label = Label("win_label", {position: [192, 90], text: "通关！", color: "#86EFAC", font_size: 28, visible: false}, [])
restart = Button("restart", {position: [340, 44], size: [112, 34], text: "重新开始", action: Action([@Set($score, 0), @RestartScene("main")])}, [])
flow = StateMachine("flow", {initial: "playing", states: [{name: "playing"}, {name: "won", on_enter: Action([@SetVisible("win_label", true), @SetInputEnabled("player", false)])}], transitions: [{from: "playing", event: "goal_reached", to: "won"}]}, [])
