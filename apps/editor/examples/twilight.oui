root = GameProject("demo", {profile: "game2d/1.0", entry_scene: "main", viewport: [960, 540], fixed_hz: 60, input_map: {move_left: ["KeyA", "ArrowLeft"], move_right: ["KeyD", "ArrowRight"], jump: ["Space"]}}, [main])
$score = 0
main = Scene2D("main", {gravity: [0, 980]}, [landscape, floor, ledge_a, ledge_b, player, coin, goal, hud, flow])
floor = StaticBody2D("floor", {name: "林地", position: [480, 500], collision_layer: 2}, [floor_shape, floor_visual])
floor_shape = CollisionShape2D("floor_shape", {shape: {type: "RectangleShape2D", size: [960, 40]}}, [])
floor_visual = Node2D("floor_visual", {name: "苔石地面"}, [earth, earth_cap, earth_moss, soil_0, soil_1, soil_2, soil_3, soil_4, soil_5, soil_6, soil_7, soil_8, soil_9, soil_10, soil_11, soil_12, soil_13, soil_14, soil_15, soil_16, soil_17, soil_18, soil_19, soil_20, soil_21, soil_22, soil_23, soil_24, soil_25, soil_26, soil_27, soil_28, soil_29, grass_0, grass_1, grass_2, grass_3, grass_4, grass_5, grass_6, grass_7, grass_8, grass_9, grass_10, grass_11, grass_12, grass_13, grass_14, grass_15, grass_16, grass_17, grass_18, grass_19, grass_20, grass_21, grass_22])
player = CharacterBody2D("player", {name: "旅人", position: [130, 462], groups: ["players"], collision_layer: 1, collision_mask: 2}, [player_shape, player_visual, move])
player_shape = CollisionShape2D("player_shape", {shape: {type: "RectangleShape2D", size: [28, 36]}}, [])
player_visual = Node2D("player_visual", {name: "旅人"}, [hero_cloak, hero_hood, hero_cap, hero_mask, hero_eye, hero_scarf, hero_tail, hero_pack, hero_boot_l, hero_boot_r])
move = PlatformerController("move", {left_action: "move_left", right_action: "move_right", jump_action: "jump", speed: 260, jump_speed: 420}, [])
coin = Area2D("coin", {name: "琥珀晶石", position: [475, 356], collision_layer: 0, collision_mask: 1, monitoring: true}, [coin_shape, coin_visual, pickup])
coin_shape = CollisionShape2D("coin_shape", {shape: {type: "CircleShape2D", radius: 12}}, [])
coin_visual = Polygon2D("coin_visual", {polygon: [[0, -12], [12, 0], [0, 12], [-12, 0]], color: "#FBBF24"}, [])
pickup = SignalRule("pickup", {signal: "body_entered", filter_group: "players", once: true, action: Action([@Set($score, $score + 1), @DestroyNode("coin")])}, [])
goal = Area2D("goal", {name: "遗迹出口", position: [820, 440], collision_layer: 0, collision_mask: 1, monitoring: true}, [goal_shape, goal_visual, win_trigger])
goal_shape = CollisionShape2D("goal_shape", {shape: {type: "RectangleShape2D", size: [40, 80]}}, [])
goal_visual = Node2D("goal_visual", {name: "遗迹之门"}, [gate_left, gate_right, gate_cap, gate_inner, gate_light, gate_plinth])
win_trigger = SignalRule("win_trigger", {signal: "body_entered", filter_group: "players", once: true, action: @EmitGameEvent("goal_reached")}, [])
hud = CanvasLayer("hud", {layer: 10}, [help_label, score_label, win_label, restart])
help_label = Label("help_label", {position: [24, 20], text: ""}, [])
score_label = Label("score_label", {position: [28, 24], text: "◆  " + $score, color: "#fff1c6", font_size: 20}, [])
win_label = Label("win_label", {position: [360, 80], text: "通关", visible: false}, [])
restart = Button("restart", {position: [850, 22], size: [86, 34], text: "重开", font_size: 14, action: @RestartScene("main")}, [])
flow = StateMachine("flow", {initial: "playing", states: [{name: "playing"}, {name: "won", on_enter: Action([@SetVisible("win_label", true), @SetInputEnabled("player", false)])}], transitions: [{from: "playing", event: "goal_reached", to: "won"}]}, [])

